  m_text: "Press Alt Fire to <color=#FF4343>freeze</color> rockets.\r\n\r\nFrozen rockets have a <color=#FF4343>larger blast radius</color> and will <color=#FF4343>stay frozen</color> even when switching weapons.\r"
  m_isRightToLeft: 0
