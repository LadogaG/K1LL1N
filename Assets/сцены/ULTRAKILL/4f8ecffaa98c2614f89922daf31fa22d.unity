  m_text: "<color=#FF4343>The Cyber Grind</color> is an endless survival mode.\n\nGood performance gives many <color=#FF4343>points</color>.\n\n<color=#FF4343>Progress in the current mission will be lost.</color>"
  m_isRightToLeft: 0
