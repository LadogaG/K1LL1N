    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "\"But yes, you're right. ▼\nI don't really care about what you or anyone else thinks of me, so I'm not interested in trying to be nice just so you'll be in a good mood.\" ▼"
