    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "\"Because nothing matters. ▼\nThere's no point in trying if the end result will be the same anyway. ▼\nTry as you might, you'll eventually just become forgotten dust in the wind like the rest of us.\" ▼"
