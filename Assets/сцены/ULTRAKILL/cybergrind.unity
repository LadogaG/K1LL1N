    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "\"I understand it logically, and I know that there is no reason to live in apathy, but my emotional side refuses to listen. ▼\nThe fear persists, and I cannot motivate myself to seek purpose, despite knowing I must.\" ▼"
--- !u!114 &18172
