    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "\"If you DON'T show me the way then YOU'RE never arriving either! ▼\nOr did that thought not even cross your crayon-fed brain cavity!?\" ▼"
--- !u!114 &18124
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 917}
  m_Enabled: 1
