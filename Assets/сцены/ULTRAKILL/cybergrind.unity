    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "\"We create distractions. ▼\nWe keep our minds busy with mundane activities and entertainment to stop ourselves from having to come face-to-face with the truth.\" ▼"
--- !u!114 &18146
