  m_RaycastPadding:
    x: 0
    y: 0
    z: 0
    w: 0
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: d1794fa91070bdc4c9e3cc144481f133, type: 3}
    m_FontSize: 22
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 2
    m_MaxSize: 22
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: '"Giving up is not accepting the end, it is simply accepting the fear of it. It is embracing despair rather than facing it."'
--- !u!114 &21707
MonoBehaviour:
  m_ObjectHideFlags: 0
