    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: '"So I''ll forgive you for your extreme transgression of laying your hands on a fair maiden if you tell me which way to go, since I seem to have gotten lost on the way." ▼'
--- !u!114 &18070
