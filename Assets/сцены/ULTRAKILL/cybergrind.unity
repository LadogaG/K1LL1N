    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "\"Existential dread is already taking hold. ▼\nI'm sure you've felt it too. ▼\nThe pain and fear of being nothing, becoming nothing. ▼\nThe suffering of understanding that.\" ▼"
