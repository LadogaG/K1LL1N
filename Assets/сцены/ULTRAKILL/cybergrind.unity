    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "\"I see. ▼\nThough as much as I'd like to embrace it, I am nevertheless struck with that paralyzing existential panic.\" ▼"
--- !u!114 &18071
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
