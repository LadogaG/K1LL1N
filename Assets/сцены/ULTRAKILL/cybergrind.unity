    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "\"Listen up, dickhead. ▼\nI don't know who you are but you've got a lot of nerve smacking someone down and not even bothering to help them back up, but since your mother didn't teach you manners, I'll let this one slide.\" ▼"
--- !u!114 &18051
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
