    r: 0.14901961
    g: 0.14901961
    b: 0.14901961
    a: 1
  m_RaycastTarget: 1
  m_RaycastPadding:
    x: 0
    y: 0
    z: 0
    w: 0
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: d1794fa91070bdc4c9e3cc144481f133, type: 3}
