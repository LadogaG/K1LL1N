    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "\"Alright, suit yourself.\nOffer still stands though, in case you change your mind at any point.\" ▼"
--- !u!114 &18072
MonoBehaviour:
  m_ObjectHideFlags: 0
