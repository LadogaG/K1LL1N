    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "\"Human intelligence is far beyond that of other animals, but it would be misguided to consider that a gift. ▼\nAll other beings have the gift of ignorance, of not understanding what we do.\" ▼"
