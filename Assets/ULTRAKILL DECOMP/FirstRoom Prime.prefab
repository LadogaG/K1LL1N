  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"<color=orange>Major Assists</color>\" consists of modifiers that change the game and its balance <color=orange>considerably</color>.\n\nIf \"Major Assists\" is enabled <color=orange>at any point</color> during a mission, the rank gained upon completion will have a blue background. This background <color=orange>can be removed</color> by achieving <color=orange>the same rank or higher</color> with \"Major Assists\" disabled for the duration of the <color=orange>entire</color> mission.\n\n\"<color=yellow>Perfect</color>\" ranks and Cyber Grind high scores cannot be achieved with \"Major Assists\" enabled."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 17da75c3ec0ce89449c93c4717e431dd, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 022a4d6a7e391f44091f2b06449d8a81, type: 2}
